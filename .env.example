# 이 파일을 .env 로 복사한 뒤 값을 바꾸세요.
# 시놀로지: docker-compose.yml 과 같은 폴더에 둡니다.

APP_PORT=3080

POSTGRES_DB=daily_report
POSTGRES_USER=daily
POSTGRES_PASSWORD=여기-DB비밀번호-바꾸세요

SESSION_SECRET=여기-긴-무작위문자-바꾸세요

BOOTSTRAP_MANAGER_EMAIL=admin@우리회사.com
BOOTSTRAP_MANAGER_PASSWORD=여기-관리자비밀번호-바꾸세요
BOOTSTRAP_MANAGER_NAME=관리자

# 직원 계정 만들기용 공유 초대 코드 (관리자가 앱에서 1회용 코드도 발급 가능)
INVITE_CODE=welcome

COOKIE_SECURE=false
